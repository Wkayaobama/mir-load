{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests", "--ignore=tests/e2e"],
  "python.testing.unittestEnabled": false,
  "files.eol": "\n",
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true },
  "files.watcherExclude": { "**/.mrload/cache/**": true, "**/.venv/**": true, "**/dbt/target/**": true },
  "terminal.integrated.defaultProfile.linux": "bash",
  "yaml.schemas": {},
  "[python]": { "editor.rulers": [110] },
  "[shellscript]": { "files.eol": "\n" }
}
