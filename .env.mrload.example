# ── mr-load operator configuration ───────────────────────────────────────────
# Copy to `.env.mrload` at the codebase root (one level above the worktree) or
# to `.env` in this worktree. Process env > .env > .env.mrload. NEVER commit.

# ── Google (walk + attach download) ─────────────────────────────────────────
# Preferred on a laptop: leave this UNSET and run `scripts/gauth.sh`, which does
#   gcloud auth login --enable-gdrive-access --update-adc   (Drive scope on user ADC;
#   `application-default login --scopes=…drive…` is REJECTED by Google for gcloud's client)
#   gcloud auth application-default set-quota-project $MRLOAD_BQ_PROJECT
#   gcloud services enable drive.googleapis.com
# Alternative: a service-account JSON; the scope root folder MUST then be shared
# with the SA email (Viewer) — silent failure otherwise (empty walk, no error).
#GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/mr-load-sa.json

# ── BigQuery (bq CLI + dbt) ─────────────────────────────────────────────────
MRLOAD_BQ_PROJECT=your-gcp-project-id
MRLOAD_BQ_DATASET=mrload          # dbt target dataset (silver)
MRLOAD_BQ_RAW_DATASET=mrload_raw  # bronze + ledger tables
MRLOAD_BQ_LOCATION=EU

# ── HubSpot ─────────────────────────────────────────────────────────────────
# Private-app token. SANDBOX FIRST (ic-load pattern). Scopes required:
#   files, crm.objects.companies.read, crm.objects.companies.write,
#   crm.objects.deals.read, crm.objects.deals.write (pass 2),
#   crm.objects.notes (engagement write).
#   hs-props (property DEFINITIONS for StackSync) additionally needs the schema/property
#   write scope of companies, deals and notes — a 403 from hs-props names the missing one.
# The Claude HubSpot connector in this workspace points at portal 9201667
# (WISeKey SA / ICALPS prod) — that is NOT the target unless you decide so.
HUBSPOT_SANDBOX_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_SANDBOX_PORTAL_ID=00000000
# preflight dies if the token resolves to portal 9201667 (prod) or to a portal other than
# HUBSPOT_SANDBOX_PORTAL_ID. Production is a deliberate choice, made here, never by accident:
#MRLOAD_ALLOW_PROD_PORTAL=1

# Pass-2 defaults (portal-specific ids; override per row in deal_decisions.csv)
MRLOAD_DEAL_PIPELINE=
MRLOAD_DEAL_STAGE=

# ── Local state ─────────────────────────────────────────────────────────────
MRLOAD_LEDGER_PATH=.mrload/ledger.sqlite
MRLOAD_CACHE_DIR=.mrload/cache

# ── Approval gates — every write is DRY unless the flag is exactly "1" ───────
# Open them ONE AT A TIME, in this order, and only from the master script.
MRLOAD_APPROVE_BQ_LOAD=0
MRLOAD_APPROVE_PROPERTY_CREATE=0   # hs-props: property definitions only, never values
MRLOAD_APPROVE_COMPANY_CREATE=0
MRLOAD_APPROVE_FILES_UPLOAD=0
MRLOAD_APPROVE_FILE_NOTES_POST=0
MRLOAD_APPROVE_DEAL_CREATE=0
MRLOAD_APPROVE_UNMIGRATE=0
